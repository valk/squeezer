# Copy to SQUEEZER_HOME/.env and fill in (default SQUEEZER_HOME is
# ~/.config/squeezer). Never commit real values — /squeezer:setup handles
# this for you; this file is just the reference shape.

# Token from @BotFather after `/newbot`.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat id. Message your bot once, then run
# daemon/telegram_get_chat_id.py to fetch and print this value via getUpdates.
TELEGRAM_ALLOWED_CHAT_ID=

# Your numeric Telegram user id (the actual sender, not the conversation) —
# same fetch step as above. For a normal 1:1 chat this equals
# TELEGRAM_ALLOWED_CHAT_ID, but it's checked separately so an inbound message
# is only ever accepted if it's really from you, not just sent in the right
# chat window (matters if this bot is ever added to a group).
TELEGRAM_OWNER_USER_ID=

# Base32 TOTP secret for the /elevate Telegram command's second factor.
# Generated by /squeezer:2fa-setup — do not hand-write this value.
TOTP_SECRET=
